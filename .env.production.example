# FamilyVault Production Environment Configuration
# Copy this file to .env.production and populate with your production Firebase credentials

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=familyvault-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=familyvault-prod
VITE_FIREBASE_STORAGE_BUCKET=familyvault-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Enforce email verification for all protected family routes in production
VITE_REQUIRE_EMAIL_VERIFICATION=true

